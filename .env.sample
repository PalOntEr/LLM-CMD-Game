DEFAULT_MODEL = "gemma4:e2b"
DEFAULT_HOST = "http://localhost:11434"

# recent messages sent verbatim; older context lives in the notes
MAX_HISTORY = 4

# compact the notes in the background once they exceed this
NOTES_LIMIT = 20

# roughly how many notes a compaction should leave
NOTES_TARGET = 10

# available actions in the game by the model
ACTIONS = stay,advance

# Hugging Face Hub / Kokoro voic cache settings
# Suppress Windows symlinks warning
HF_HUB_DISABLE_SYMLINKS_WARNING = 1

# Run offline to use local cache directly without pinging HF on startup (set to 0 if downloading for the first time)
HF_HUB_OFFLINE = 1
